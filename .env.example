# ==============================================================================
# Multi-Agent AI Data Analyst — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to '.env' at the project root before running the application:
#   PowerShell: Copy-Item .env.example .env
#
# Production configuration with live MySQL and AI providers.
# No offline or mock fallback modes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Checkpoint Persistence Configuration (MySQL on localhost:3306)
# ------------------------------------------------------------------------------
PYTHONPATH=backend

# Dedicated read-only MySQL user connection string:
# IMPORTANT: If your password contains special characters like '@', ':', '/', '?',
# URL-encode the password using urllib.parse.quote_plus (e.g. '@' becomes '%40').
DATABASE_URL=mysql+pymysql://ai_analyst:YOUR_URL_ENCODED_PASSWORD@localhost:3306/classicmodels

# SQLite paths for session history, durable LangGraph checkpoints, and dataset store
APP_DATABASE_PATH=./backend/data/app.db
CHECKPOINT_DATABASE_PATH=./backend/data/checkpoints.db
DATASET_STORE_PATH=./backend/data/datasets.db

# ------------------------------------------------------------------------------
# 2. AI Provider API Keys (Required)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_TIMEOUT_SECONDS=90

# ------------------------------------------------------------------------------
# 3. Workload-Specific OpenAI Models & Reasoning Effort
# ------------------------------------------------------------------------------
# SQL Generation (low reasoning effort)
OPENAI_SQL_MODEL=gpt-6-luna

# Investigation Planning (medium reasoning effort)
OPENAI_PLANNER_MODEL=gpt-6.1-sol

# Complex Root Cause Analysis (high reasoning effort)
OPENAI_RCA_MODEL=gpt-6.1-sol

# Hypothesis Generation (medium reasoning effort)
OPENAI_HYPOTHESIS_MODEL=gpt-6.1-sol

# Evidence Review & Refinement Decision (medium reasoning effort)
OPENAI_REVIEW_MODEL=gpt-6.1-sol

# Business Insight Generation (medium reasoning effort)
OPENAI_INSIGHT_MODEL=gpt-6.1-terra

# Executive Report Generation (low reasoning effort)
OPENAI_REPORT_MODEL=gpt-6.1-terra

# Schema Interpretation & Python Tool Selection (low reasoning effort)
OPENAI_SCHEMA_MODEL=gpt-6-luna
OPENAI_TOOL_SELECTION_MODEL=gpt-6-luna

# Autonomous Research Agents (medium reasoning effort)
OPENAI_PYTHON_MODEL=gpt-6.1-sol
OPENAI_SQL_RESEARCH_MODEL=gpt-6.1-sol

# ------------------------------------------------------------------------------
# 4. OpenRouter Jev Decision Router
# ------------------------------------------------------------------------------
OPENROUTER_JEV_MODEL=typesafe/jev-1.14
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# ------------------------------------------------------------------------------
# 5. Security Guardrails, Sandbox Execution & Budgets
# ------------------------------------------------------------------------------
SQL_GENERATION_MODE=compiled
MAX_SQL_RETRIES=2
MAX_PLAN_REFINEMENTS=1
MAX_AGENT_STEPS=2
MAX_INVESTIGATION_QUERIES=6
MAX_PARALLEL_DB_QUERIES=3
MAX_PARALLEL_TASKS=4
MAX_PLAN_TASKS=16
MAX_RESULT_ROWS=500
MAX_QUERY_SECONDS=10
MAX_RUN_SECONDS=240
MAX_RUN_TOKENS=250000
MAX_RUN_COST_USD=2.0

# Sandbox Execution Service (isolated_process | e2b | docker)
SANDBOX_PROVIDER=isolated_process
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_ALLOW_EXTERNAL_DATA_TRANSFER=false

# ------------------------------------------------------------------------------
# 6. Networking & Frontend
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_TOKEN=
